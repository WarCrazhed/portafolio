---
import SectionHeading from "./SectionHeading.astro";
import Tag from "./Tag.astro";
import { skillGroups } from "../assets/data/skills";
---

<section id="stack" class="border-b border-hairline">
  <div
    class="mx-auto grid max-w-site gap-10 px-5 py-20 md:px-10 lg:grid-cols-12 lg:gap-8 lg:px-16 lg:pb-24 lg:pt-28"
  >
    <div class="flex flex-col gap-3 lg:col-span-4">
      <SectionHeading index="03" title="Stack">Con qué trabajo</SectionHeading>
      <p class="mt-2 text-pretty leading-relaxed text-muted">
        Del backend al despliegue. Lo que uso a diario aparece primero.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:col-span-8">
      {
        skillGroups.map((group) => (
          <div class="flex flex-col gap-3.5 rounded-xl border border-line bg-surface p-5">
            <h3 class="font-mono text-[11px] uppercase tracking-[0.08em] text-dim">
              {group.title}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => <Tag variant="filled">{item}</Tag>)}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
