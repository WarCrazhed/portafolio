---
import Tag from "./Tag.astro";

interface Props {
  position: string;
  enterprise: string;
  date: string;
  meta?: string;
  description: string | string[];
  technologies: string[];
}

const { position, enterprise, date, meta, description, technologies } = Astro.props;
const bullets = Array.isArray(description) ? description : null;
---

<div class="grid gap-4 border-t border-line py-8 lg:grid-cols-12 lg:gap-8 lg:py-10">
  <div class="flex flex-col gap-1.5 font-mono text-[13px] text-muted lg:col-span-3">
    <span class="text-ink">{date}</span>
    {meta && <span>{meta}</span>}
  </div>
  <div class="flex flex-col gap-4 lg:col-span-9">
    <div class="flex flex-col gap-1">
      <h3 class="text-xl font-semibold tracking-[-0.01em] lg:text-2xl">{position}</h3>
      <span class="font-medium text-accent">{enterprise}</span>
    </div>
    {
      bullets ? (
        <ul class="flex list-disc flex-col gap-2 pl-[18px] leading-relaxed text-muted">
          {bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      ) : (
        <p class="leading-relaxed text-muted">{description}</p>
      )
    }
    <div class="flex flex-wrap gap-2">
      {technologies.map((item) => <Tag>{item}</Tag>)}
    </div>
  </div>
</div>
