---
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { projects } from "../assets/data/projects";

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<section id="projects" class="border-b border-hairline">
  <div
    class="mx-auto flex max-w-site flex-col gap-10 px-5 py-20 md:px-10 lg:gap-12 lg:px-16 lg:pb-24 lg:pt-28"
  >
    <SectionHeading index="01" title="Proyectos">Proyectos</SectionHeading>

    <div class="grid gap-5 md:grid-cols-2 lg:gap-6">
      {featured.map((project) => <ProjectCard {...project} />)}
    </div>

    <div class="flex flex-col">
      <div
        class="grid grid-cols-12 gap-4 border-b border-line px-4 pb-3 font-mono text-[11px] uppercase tracking-[0.08em] text-dim"
      >
        <span class="col-span-8 md:col-span-4">Proyectos personales</span>
        <span class="hidden md:col-span-5 md:block">Stack</span>
        <span class="col-span-4 text-right md:col-span-3">Enlaces</span>
      </div>
      {
        others.map((p) => (
          <div class="grid grid-cols-12 items-center gap-x-4 gap-y-1 border-b border-hairline px-4 py-4 transition hover:bg-surface">
            <span class="col-span-8 font-medium md:col-span-4">{p.title}</span>
            <span class="col-span-12 order-last font-mono text-xs text-muted md:order-none md:col-span-5">
              {p.tags.join(" · ")}
            </span>
            <span class="col-span-4 flex justify-end gap-4 font-mono text-xs tracking-[0.04em] md:col-span-3">
              {p.repoUrl && (
                <a
                  href={p.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Repositorio de ${p.title}`}
                  class="text-muted transition hover:text-accent"
                >
                  Repo
                </a>
              )}
              {p.liveUrl && (
                <a
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Demo de ${p.title}`}
                  class="flex items-center gap-1 transition hover:text-accent"
                >
                  Demo
                  <ArrowIcon />
                </a>
              )}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
