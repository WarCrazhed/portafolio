---
import { Image } from "astro:assets";
import { TextAnimate } from "./TextAnimate";
import ArrowIcon from "./ArrowIcon.astro";
import Profile from "../assets/profile.jpg";

---

<section id="home" class="grid-bg border-b border-hairline">
  <div
    class="mx-auto grid max-w-site gap-10 px-5 pb-20 pt-16 md:px-10 lg:grid-cols-12 lg:items-center lg:gap-8 lg:px-16 lg:pb-24 lg:pt-28"
  >
    <div class="flex flex-col gap-6 lg:col-span-7 lg:gap-8">
      <p class="reveal font-mono text-[13px] tracking-[0.08em] text-accent">
        // <TextAnimate client:load />
      </p>
      <h1
        class="reveal d1 text-balance text-[40px] font-semibold leading-[1.02] tracking-[-0.03em] md:text-6xl lg:text-[84px] lg:leading-[0.98]"
      >
        Construyo plataformas web que la gente usa todos los días.
      </h1>
      <div class="reveal d2 flex max-w-[620px] flex-col gap-4 text-pretty text-base leading-relaxed text-muted md:text-lg lg:text-[19px]">
        <p>
          Soy un <strong class="font-semibold text-accent">Desarrollador FullStack</strong>
          con experiencia en <strong class="font-medium text-ink">diseño de sistemas escalables</strong>
          e interfaces intuitivas, enfocado en resolver problemas y construir
          herramientas digitales que generan impacto positivo.
        </p>
        <p>
          Como <strong class="font-semibold text-accent">Ingeniero en Desarrollo y Gestión de Software</strong>,
          siempre estoy en busca de nuevos desafíos que me permitan crecer y
          aportar valor con soluciones innovadoras.
        </p>
      </div>
      <div class="reveal d3 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a
          href="#projects"
          class="flex h-12 items-center justify-center gap-2.5 rounded-lg bg-accent px-6 text-[15px] font-semibold text-accent-ink transition hover:brightness-110"
        >
          Ver proyectos
          <ArrowIcon size={16} />
        </a>
        <div class="flex gap-3 sm:gap-4">
          <a
            href="https://github.com/WarCrazhed"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-12 flex-1 items-center justify-center rounded-lg border border-line px-5 text-[15px] font-medium transition hover:border-accent hover:text-accent"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/mario-zamora-b4bb07224/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-12 flex-1 items-center justify-center rounded-lg border border-line px-5 text-[15px] font-medium transition hover:border-accent hover:text-accent"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-5 lg:items-end">
      <div
        class="h-24 w-24 overflow-hidden rounded-xl border border-line bg-surface lg:h-[360px] lg:w-[360px] lg:rounded-2xl"
      >
        <Image
          src={Profile}
          alt="Mario Zamora"
          width="480"
          height="480"
          class="h-full w-full object-cover object-center saturate-[0.9]"
          loading="eager"
        />
      </div>
      <div
        class="flex w-full flex-col gap-3 rounded-xl border border-line bg-surface px-4 py-4 lg:w-[360px]"
      >
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span
              class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgb(52_211_153/0.15)]"
            ></span>
            <span class="font-mono text-xs uppercase tracking-[0.06em] text-muted">
              Actualmente
            </span>
          </div>
          <span class="font-mono text-xs text-dim">Jalisco, México</span>
        </div>
        <p class="text-[15px] leading-snug">
          Gerente de Funcionalidad Tecnológica en <strong class="font-semibold">Humana 11</strong> — lidero un equipo
          de 3 a cargo de 4 plataformas en producción.
        </p>
      </div>
    </div>
  </div>

</section>
