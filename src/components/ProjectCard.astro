---
import { Image } from "astro:assets";
import Tag from "./Tag.astro";
import ArrowIcon from "./ArrowIcon.astro";

const { title, description, image, tags, repoUrl, liveUrl } = Astro.props;
const host = liveUrl ? new URL(liveUrl).hostname.replace(/^www\./, "") : null;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition duration-200 hover:-translate-y-0.5 hover:border-dim"
>
  <div class="aspect-[16/9] overflow-hidden border-b border-line bg-hairline lg:aspect-auto lg:h-[300px]">
    <Image
      src={image}
      alt={`Vista previa de ${title}`}
      width={880}
      class="h-full w-full object-cover object-top"
      loading="lazy"
    />
  </div>
  <div class="flex flex-grow flex-col gap-3.5 p-5 lg:p-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
      <h3 class="text-xl font-semibold tracking-[-0.01em] lg:text-[22px]">{title}</h3>
      {
        liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Abrir ${title}`}
            class="flex max-w-full items-center gap-1.5 break-all font-mono sm:shrink-0 sm:pt-1.5 text-xs uppercase tracking-[0.06em] text-accent transition hover:text-ink"
          >
            {host}
            <ArrowIcon />
          </a>
        )
      }
    </div>
    <p class="text-[15px] leading-relaxed text-muted">{description}</p>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: string) => <Tag>{tag}</Tag>)}
    </div>
    {
      repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto flex items-center gap-1.5 self-start pt-2 font-mono text-xs uppercase tracking-[0.06em] text-muted transition hover:text-accent"
        >
          Repositorio
          <ArrowIcon />
        </a>
      )
    }
  </div>
</article>
