---
import ExperienceItem from "./ExperienceItem.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="experience" class="border-b border-hairline">
  <div
    class="mx-auto flex max-w-site flex-col gap-10 px-5 py-20 md:px-10 lg:gap-12 lg:px-16 lg:pb-24 lg:pt-28"
  >
    <SectionHeading index="02" title="Experiencia">Dónde he construido</SectionHeading>

    <div class="flex flex-col border-b border-line">
      <ExperienceItem
        position="Gerente de Funcionalidad Tecnológica"
        enterprise="Humana 11"
        date="2023 — Presente"
        meta="Jalisco, México"
        description={[
          "Lidero el área (equipo de 3) a cargo de las 4 plataformas web de la empresa: diagnósticos de DO, Universidad Humana Empresaria, seguimiento de vacantes y sitio corporativo.",
          "Migré la aplicación principal de PHP nativo a Laravel + React y establecí ese stack como estándar.",
          "Sustituí el hosting compartido en cPanel por infraestructura propia en Linode: servidores por SSH, despliegues estandarizados con Docker y Git.",
        ]}
        technologies={[
          "Laravel",
          "React",
          "React Native",
          "TypeScript",
          "Tailwind",
          "MySQL",
          "Docker",
          "Linux",
        ]}
      />
      <ExperienceItem
        position="Desarrollador"
        enterprise="Massware"
        date="Ene — Abr 2023"
        meta="Prácticas · Ingeniería"
        description="Desarrollé un módulo especializado para brigadistas: backend y gestión de base de datos con Django, e interfaces dinámicas y responsivas con JavaScript y Bootstrap."
        technologies={["Django", "Python", "JavaScript", "Bootstrap"]}
      />
      <ExperienceItem
        position="Desarrollador"
        enterprise="ViajeSoft"
        date="May — Jun 2021"
        meta="Prácticas · TSU"
        description="Módulos críticos para varios proyectos bajo metodologías de equipo: lógica de negocio con PHP y JavaScript, interfaces interactivas con jQuery y Bootstrap."
        technologies={["PHP", "JavaScript", "jQuery", "Bootstrap", "MySQL"]}
      />
    </div>
  </div>
</section>
