---
import ExperienceItem from "./ExperienceItem.astro";
---

<section
  class="min-h-screen container mx-auto flex flex-col gap-12 max-w-4xl px-4 py-20" id="experience"
>
  <!-- Título -->
  <div class="flex items-center gap-3">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-8 h-8 text-blue-500"
    >
      <path
        fill-rule="evenodd"
        d="M7.5 5.25a3 3 0 0 1 3-3h3a3 3 0 0 1 3 3v.205c.933.085 1.857.197 2.774.334 1.454.218 2.476 1.483 2.476 2.917v3.033c0 1.211-.734 2.352-1.936 2.752A24.726 24.726 0 0 1 12 15.75c-2.73 0-5.357-.442-7.814-1.259-1.202-.4-1.936-1.541-1.936-2.752V8.706c0-1.434 1.022-2.7 2.476-2.917A48.814 48.814 0 0 1 7.5 5.455V5.25Zm7.5 0v.09a49.488 49.488 0 0 0-6 0v-.09a1.5 1.5 0 0 1 1.5-1.5h3a1.5 1.5 0 0 1 1.5 1.5Zm-3 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"
        clip-rule="evenodd"></path>
      <path
        d="M3 18.4v-2.796a4.3 4.3 0 0 0 .713.31A26.226 26.226 0 0 0 12 17.25c2.892 0 5.68-.468 8.287-1.335.252-.084.49-.189.713-.311V18.4c0 1.452-1.047 2.728-2.523 2.923-2.12.282-4.282.427-6.477.427a49.19 49.19 0 0 1-6.477-.427C4.047 21.128 3 19.852 3 18.4Z"
      ></path>
    </svg>
    <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-200">
      Experiencia Laboral
    </h2>
  </div>

  <div class="relative flex flex-col space-y-12">
    <div
      class="absolute left-2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-gray-700 to-transparent dark:via-gray-300"
    >
    </div>
    <ExperienceItem
      position="Gerente de Funcionalidad Tecnológica"
      enterprise="Humana 11"
      date="Enero 2023 - Presente"
      description="Lidero el área de Funcionalidad Tecnológica (equipo de 3) a cargo de las 4 plataformas web de la empresa: diagnósticos de Desarrollo Organizacional (hasta 1,500 evaluaciones mensuales para empresas cliente), la plataforma educativa Universidad Humana Empresaria (40 usuarios activos por semana), el sistema de seguimiento de vacantes y el sitio corporativo con panel administrativo de contenidos. Migré la aplicación principal de PHP nativo a Laravel + React y establecí ese stack como estándar. Sustituí el hosting compartido en cPanel por infraestructura propia en Linode, administrando los servidores por SSH y estandarizando los despliegues con Docker y Git."
      technologies={[
        "Laravel",
        "React",
        "React Native",
        "TypeScript",
        "Tailwindcss",
        "MySql",
        "Docker",
        "Linux",
      ]}
    />
    <ExperienceItem
      position="Desarrollador / Prácticas Profesionales (Ingeniería)"
      enterprise="Massware"
      date="Enero 2023 - Abril 2023"
      description="En paralelo a mi rol en Humana11, desarrollé un módulo especializado para brigadistas con Django para la arquitectura del backend y la gestión eficiente de bases de datos. Diseñé interfaces dinámicas y responsivas integrando JavaScript y Bootstrap, asegurando una experiencia de usuario fluida."
      technologies={["Django", "Python", "JavaScript", "Bootstrap"]}
    />
    <ExperienceItem
      position="Desarrollador / Prácticas Profesionales (TSU)"
      enterprise="ViajeSoft"
      date="Mayo 2021 - Junio 2021"
      description="Colaboré en el desarrollo de módulos críticos para múltiples proyectos, trabajando bajo metodologías de equipo para asegurar entregas eficientes. Implementé lógica de negocio con PHP y JavaScript, además de diseñar interfaces interactivas y responsivas mediante jQuery y Bootstrap."
      technologies={["Php", "JavaScript", "JQuery", "Bootstrap", "MySql"]}
    />
  </div>
</section>
