---
import SectionHeading from "./SectionHeading.astro";
---

<section id="education" class="border-b border-hairline">
  <div
    class="mx-auto grid max-w-site gap-10 px-5 py-20 md:px-10 lg:grid-cols-12 lg:gap-8 lg:px-16 lg:pb-24 lg:pt-28"
  >
    <div class="lg:col-span-4">
      <SectionHeading index="04" title="Educación">Formación</SectionHeading>
    </div>
    <div
      class="grid gap-4 border-y border-line py-8 lg:col-span-8 lg:grid-cols-12 lg:gap-8"
    >
      <div class="font-mono text-[13px] lg:col-span-3">2019 — 2023</div>
      <div class="flex flex-col gap-2 lg:col-span-9">
        <h3 class="text-xl font-semibold tracking-[-0.01em] lg:text-[22px]">
          Ingeniería en Desarrollo y Gestión de Software
        </h3>
        <span class="font-medium text-accent">Universidad Tecnológica de Jalisco</span>
        <p class="mt-1 leading-relaxed text-muted">
          Desarrollo de software, gestión de proyectos tecnológicos y
          arquitectura de aplicaciones web, con enfoque práctico mediante
          estadías profesionales en empresas del sector.
        </p>
      </div>
    </div>
  </div>
</section>
