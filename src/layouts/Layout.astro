---
import Navbar from "../components/Layout/Navbar.astro";
import Networks from "../components/Networks.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Mario Zamora — Desarrollador FullStack</title>
    <meta
      name="description"
      content="Portafolio de Mario Zamora, Desarrollador FullStack e Ingeniero en Desarrollo y Gestión de Software. Experiencia en Laravel, React, TypeScript y despliegues con Docker."
    />
    <meta name="author" content="Mario Zamora" />
    <link rel="canonical" href="https://mariozamoraportafolio.netlify.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mariozamoraportafolio.netlify.app/" />
    <meta property="og:title" content="Mario Zamora — Desarrollador FullStack" />
    <meta
      property="og:description"
      content="Portafolio de Mario Zamora, Desarrollador FullStack e Ingeniero en Desarrollo y Gestión de Software. Experiencia en Laravel, React, TypeScript y despliegues con Docker."
    />
    <meta
      property="og:image"
      content="https://mariozamoraportafolio.netlify.app/img/profile.jpg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body
    class="bg-gradient-to-br dark:bg-gradient-to-br from-gray-200 via-blue-200 to-purple-200 dark:from-blue-950 dark:via-purple-950 dark:to-blue-950 bg-cover dark:text-white"
  >
    <Navbar />
    <slot />
    <footer
      class="bg-gray-950 py-16 w-full flex flex-col md:flex-row lg:flex-row justify-start gap-3 items-center border-t border-t-gray-800"
    >
      <div class="container m-auto max-w-4xl">
        <div
          class="flex flex-col lg:flex-row justify-between items-center my-5 gap-8"
        >
          <div class="text-white text-sm text-center lg:text-left">
            <p class="font-medium text-xl">
              <span
                class="transition-all duration-200 bg-gradient-to-r from-blue-300 to-purple-300 bg-clip-text hover:text-transparent font-bold"
                >Mario Zamora
              </span>
            </p>
            <p class="text-xs">
              ©{new Date().getFullYear()} Casi todos los derechos reservados
            </p>
          </div>
          <div class="text-white">
            <Networks />
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
