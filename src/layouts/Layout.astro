---
import Navbar from "../components/Layout/Navbar.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Mario Zamora — Desarrollador FullStack</title>
    <meta
      name="description"
      content="Portafolio de Mario Zamora, Desarrollador FullStack e Ingeniero en Desarrollo y Gestión de Software. Experiencia en Laravel, React, TypeScript y despliegues con Docker."
    />
    <meta name="author" content="Mario Zamora" />
    <link rel="canonical" href="https://mariozamoraportafolio.netlify.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mariozamoraportafolio.netlify.app/" />
    <meta property="og:title" content="Mario Zamora — Desarrollador FullStack" />
    <meta
      property="og:description"
      content="Portafolio de Mario Zamora, Desarrollador FullStack e Ingeniero en Desarrollo y Gestión de Software. Experiencia en Laravel, React, TypeScript y despliegues con Docker."
    />
    <meta
      property="og:image"
      content="https://mariozamoraportafolio.netlify.app/img/profile.jpg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Oscuro por defecto; el modo claro solo si el usuario lo eligió.
      if (localStorage.theme === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="bg-bg text-ink font-sans antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <footer
      class="mx-auto flex max-w-site flex-col gap-1.5 border-t border-hairline px-5 py-7 font-mono text-xs tracking-[0.04em] text-dim md:flex-row md:items-center md:justify-between md:px-10 lg:px-16"
    >
      <span>© {new Date().getFullYear()} Mario Zamora</span>
      <span>Hecho con Astro + Tailwind · Jalisco, MX</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --c-bg: 246 245 241;
    --c-surface: 255 255 255;
    --c-line: 226 224 218;
    --c-hairline: 234 232 226;
    --c-ink: 21 22 26;
    --c-muted: 92 98 112;
    --c-dim: 139 144 156;
    --c-accent: 47 111 224;
    --c-accent-ink: 255 255 255;
    color-scheme: light;
  }
  :root.dark {
    --c-bg: 15 16 19;
    --c-surface: 22 24 29;
    --c-line: 38 42 51;
    --c-hairline: 31 35 43;
    --c-ink: 233 232 227;
    --c-muted: 139 144 156;
    --c-dim: 92 98 112;
    --c-accent: 76 141 255;
    --c-accent-ink: 15 16 19;
    color-scheme: dark;
  }

  .grid-bg {
    background-image:
      linear-gradient(rgb(var(--c-hairline) / 0.7) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--c-hairline) / 0.7) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .reveal {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .reveal.d1 { animation-delay: 0.08s; }
  .reveal.d2 { animation-delay: 0.16s; }
  .reveal.d3 { animation-delay: 0.24s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; }
  }
</style>
